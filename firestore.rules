rules_version = '2';

// A signed-in user can read and write only their own devices, sessions, and events.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /devices/{deviceId} {
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /sessions/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;

      match /commands/{commandId} {
        allow read, write: if signedIn() && uid == request.auth.uid;
      }
    }

    // Events are an append-only log.
    match /events/{eventId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}
