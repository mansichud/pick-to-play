# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=pick-to-play
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = use the local emulator suite (npm run emulators) instead of the real project
VITE_USE_EMULATORS=true

# Emulator-only test account (emulator data is wiped on restart; create it from the sign-in screen):
#   tester@picktoplay.test / emulator-pass-1

# TMDB: themoviedb.org > Settings > API > "API Read Access Token" (the long one)
VITE_TMDB_READ_TOKEN=
